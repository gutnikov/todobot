# Copy to .env for `make dev` / `make migrate` / `make serve` (.env is git-ignored). The README explains each one.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/todobot
TELEGRAM_BOT_TOKEN=123456789:replace-with-the-token-from-BotFather
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-string
# TELEGRAM_API_BASE=https://api.telegram.org
# PORT=8080
# APP_VERSION=dev
# The bot only for these Telegram user ids (ACC), separated by commas; anyone else is refused. Unset or empty: every
# user is served, and serve warns at start (access_open).
# TELEGRAM_ALLOWED_USER_IDS=123456789
# Errors to PostHog's error tracking (ERR): the project's token; without it serve sends PostHog nothing.
# POSTHOG_PROJECT_TOKEN=
# POSTHOG_HOST=https://eu.i.posthog.com
