{
  "extraKnownMarketplaces": {
    "agentify": {
      "source": {
        "source": "git",
        "url": "git@github.com:gutnikov/agentify.git"
      }
    }
  },
  "enabledPlugins": {
    "agentify@agentify": true
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/agentify/loops/verify/stop-hook",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
